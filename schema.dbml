Project clinicas {
  database_type: 'MySQL'
  Note: '''
    Sistema de gestión clínica con farmacia integrada (proyecto UMES, Quetzaltenango).
    Fuente de verdad del esquema de BD. Un cambio de modelo se hace aquí primero
    y luego en las entidades de TypeORM (ver AGENTS.md sección 6), nunca al revés.
    La BD se crea vía migraciones de TypeORM, no ejecutando el SQL generado por dbml2sql.
  '''
}

// =====================================================================
// ENUM que se queda como enum (no se normaliza a catálogo)
// =====================================================================
// Justificación: es la única "acción" que un interceptor/subscriber de
// auditoría puede emitir. Es un conjunto cerrado atado al ciclo de vida
// del ORM (INSERT/UPDATE/DELETE) más el caso especial LOGIN emitido por
// AuthService. Ningún usuario de negocio (ADMIN incluido) necesita
// agregar un quinto valor desde la UI, así que no amerita tabla catálogo.
Enum accion_auditoria {
  INSERT
  UPDATE
  DELETE
  LOGIN
}

// =====================================================================
// CATÁLOGOS (antes eran enums de TypeORM, ahora tablas administrables)
// =====================================================================

Table roles {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'ADMIN, MEDICO, RECEPCION, FARMACIA']
  nombre varchar(100) [not null]
  activo boolean [not null, default: true]

  Note: 'Catálogo de roles de usuario. Reemplaza el enum RolUsuario.'
}

Table estados_cita {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'PROGRAMADA, CONFIRMADA, EN_CURSO, COMPLETADA, CANCELADA, NO_ASISTIO']
  nombre varchar(100) [not null]
  es_final boolean [not null, default: false]

  Note: 'Catálogo de estados de cita. Las transiciones válidas (sección 5.6 de AGENTS.md) se validan en el service, no en la BD.'
}

Table estados_paciente {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'ACTIVO, INACTIVO, FALLECIDO']
  nombre varchar(100) [not null]
}

Table estados_receta {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'EMITIDA, DISPENSADA_PARCIAL, DISPENSADA, ANULADA']
  nombre varchar(100) [not null]
  es_final boolean [not null, default: false]
}

Table tipos_producto {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'MEDICAMENTO, MUESTRA_MEDICA, INSUMO']
  nombre varchar(100) [not null]
}

Table tipos_movimiento_inventario {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'ENTRADA, SALIDA, AJUSTE, VENCIMIENTO']
  nombre varchar(100) [not null]
}

Table tipos_alerta {
  id int [pk, increment]
  codigo varchar(40) [unique, not null, note: 'CONTROL_VENCIDO, SIN_CITA_PROGRAMADA, VALOR_FUERA_RANGO, MEDICACION_POR_TERMINAR']
  nombre varchar(150) [not null]
}

Table severidades_alerta {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'BAJA, MEDIA, ALTA, CRITICA']
  nombre varchar(100) [not null]
  nivel int [not null, note: '1 = menos severa']
}

Table estados_alerta {
  id int [pk, increment]
  codigo varchar(30) [unique, not null, note: 'PENDIENTE, VISTA, ATENDIDA, DESCARTADA']
  nombre varchar(100) [not null]
}

Table categorias_prioridad {
  id int [pk, increment]
  codigo varchar(50) [unique, not null]
  nombre varchar(150) [not null]
  nivel int [not null, note: '1 = más alta']
  activo boolean [not null, default: true]

  Note: 'Ya era catálogo en el diseño original (AGENTS.md 5.4): adulto mayor, embarazada, discapacidad, pediátrico, crónico descompensado, etc.'
}

Table especialidades {
  id int [pk, increment]
  nombre varchar(150) [unique, not null]
  activo boolean [not null, default: true]
}

Table enfermedades_cronicas {
  id int [pk, increment]
  codigo_cie10 varchar(20) [unique]
  nombre varchar(150) [not null]
  frecuencia_control_dias int [not null]
  activo boolean [not null, default: true]
}

// =====================================================================
// AUDITORÍA
// =====================================================================

Table auditoria_logs {
  id int [pk, increment]
  usuario_id int [note: 'Nullable: un LOGIN fallido puede no resolver un usuario válido']
  accion accion_auditoria [not null]
  tabla_afectada varchar(100) [not null]
  registro_id varchar(50) [note: 'PK del registro afectado, como string para soportar cualquier tipo']
  datos_anteriores json [note: 'Snapshot antes del cambio. Null en INSERT y LOGIN']
  datos_nuevos json [note: 'Snapshot después del cambio. Null en DELETE y LOGIN']
  ip varchar(45)
  creado_en timestamp [not null, default: `now()`]

  Note: '''
    Bitácora central. La llena exclusivamente AuditService:
    - automáticamente desde AuditSubscriber (afterInsert/afterUpdate/afterRemove) para toda entidad de negocio
    - manualmente desde AuthService para accion = LOGIN
    Ningún otro service escribe aquí directamente.
  '''
}

// =====================================================================
// USUARIOS Y MÉDICOS
// =====================================================================

Table usuarios {
  id int [pk, increment]
  nombres varchar(150) [not null]
  apellidos varchar(150) [not null]
  email varchar(200) [unique, not null]
  password_hash varchar(200) [not null]
  rol_id int [not null]
  activo boolean [not null, default: true]
  created_by int [note: 'Nullable: el primer ADMIN lo crea el seed, sin creador']
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table medicos {
  id int [pk, increment]
  usuario_id int [unique, not null]
  especialidad_id int [not null]
  numero_colegiado varchar(50) [unique, not null]
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// PACIENTES (prioridades y defunciones incluidas)
// =====================================================================

Table pacientes {
  id int [pk, increment]
  codigo varchar(20) [unique, not null, note: 'PAC-000001']
  nombres varchar(150) [not null]
  apellidos varchar(150) [not null]
  dpi varchar(20) [unique, note: 'Opcional pero único si existe']
  fecha_nacimiento date
  genero varchar(20)
  telefono varchar(30)
  direccion varchar(255)
  estado_id int [not null]
  es_prioritario boolean [not null, default: false, note: 'Se recalcula en el service, no se edita directo por la API']
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table paciente_prioridades {
  id int [pk, increment]
  paciente_id int [not null]
  categoria_prioridad_id int [not null]
  activo boolean [not null, default: true]
  fecha_asignacion date [not null]
  fecha_retiro date
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table defunciones {
  id int [pk, increment]
  paciente_id int [unique, not null]
  fecha date [not null]
  causa varchar(255) [not null]
  numero_certificado varchar(50)
  medico_certifica_id int [not null]
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// ENFERMEDADES CRÓNICAS (asignación por paciente)
// =====================================================================

Table paciente_enfermedades_cronicas {
  id int [pk, increment]
  paciente_id int [not null]
  enfermedad_cronica_id int [not null]
  frecuencia_control_dias_override int
  activo boolean [not null, default: true]
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// CITAS
// =====================================================================

Table citas {
  id int [pk, increment]
  paciente_id int [not null]
  medico_id int [not null]
  fecha_hora_inicio datetime [not null]
  fecha_hora_fin datetime [not null]
  estado_id int [not null]
  nivel_prioridad int [note: 'Copia del nivel de prioridad más alto del paciente al momento de crear la cita']
  es_control_cronico boolean [not null, default: false]
  motivo_cancelacion varchar(255)
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// HISTORIAL MÉDICO
// =====================================================================

Table consultas {
  id int [pk, increment]
  cita_id int [note: 'Nullable: una consulta puede no venir de una cita agendada']
  paciente_id int [not null]
  medico_id int [not null]
  fecha datetime [not null]
  motivo varchar(255)
  diagnostico varchar(500)
  notas text
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table signos_vitales {
  id int [pk, increment]
  consulta_id int [unique, not null]
  presion_sistolica int
  presion_diastolica int
  glucosa decimal(6,2)
  saturacion_o2 decimal(5,2)
  temperatura decimal(4,1)
  peso decimal(5,2)
  talla decimal(4,2)
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table alergias {
  id int [pk, increment]
  paciente_id int [not null]
  descripcion varchar(255) [not null]
  severidad varchar(30)
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table antecedentes {
  id int [pk, increment]
  paciente_id int [not null]
  tipo varchar(50) [not null]
  descripcion varchar(500) [not null]
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// FARMACIA (productos, lotes, movimientos de inventario)
// =====================================================================

Table productos {
  id int [pk, increment]
  codigo varchar(30) [unique, not null]
  nombre varchar(200) [not null]
  principio_activo varchar(200)
  tipo_producto_id int [not null]
  costo_unitario decimal(10,2) [not null, default: 0, note: '0 para muestras médicas']
  stock_minimo int [not null, default: 0]
  activo boolean [not null, default: true]
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table lotes {
  id int [pk, increment]
  producto_id int [not null]
  numero_lote varchar(50) [not null]
  fecha_vencimiento date [not null]
  cantidad_actual int [not null, default: 0, note: 'Nunca se modifica directo; siempre vía movimientos_inventario']
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table movimientos_inventario {
  id int [pk, increment]
  lote_id int [not null]
  tipo_movimiento_id int [not null]
  cantidad int [not null]
  referencia_tipo varchar(50) [note: 'p. ej. "receta_detalle" cuando la salida viene de una dispensación']
  referencia_id int
  fecha datetime [not null]
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// RECETAS
// =====================================================================

Table recetas {
  id int [pk, increment]
  codigo varchar(20) [unique, not null, note: 'REC-000001']
  paciente_id int [not null]
  medico_id int [not null]
  estado_id int [not null]
  fecha_emision datetime [not null]
  vigente_hasta date [not null]
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

Table receta_detalles {
  id int [pk, increment]
  receta_id int [not null]
  producto_id int [not null]
  cantidad_prescrita int [not null]
  cantidad_dispensada int [not null, default: 0]
  indicaciones varchar(255)
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// ALERTAS (pacientes crónicos)
// =====================================================================

Table alertas {
  id int [pk, increment]
  paciente_id int [not null]
  tipo_alerta_id int [not null]
  severidad_id int [not null]
  estado_id int [not null]
  mensaje varchar(500) [not null]
  fecha_generada datetime [not null]
  fecha_atendida datetime
  created_by int
  updated_by int
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
}

// =====================================================================
// RELACIONES
// =====================================================================

Ref: usuarios.rol_id > roles.id
Ref: usuarios.created_by > usuarios.id
Ref: usuarios.updated_by > usuarios.id

Ref: medicos.usuario_id > usuarios.id
Ref: medicos.especialidad_id > especialidades.id
Ref: medicos.created_by > usuarios.id
Ref: medicos.updated_by > usuarios.id

Ref: pacientes.estado_id > estados_paciente.id
Ref: pacientes.created_by > usuarios.id
Ref: pacientes.updated_by > usuarios.id

Ref: paciente_prioridades.paciente_id > pacientes.id
Ref: paciente_prioridades.categoria_prioridad_id > categorias_prioridad.id
Ref: paciente_prioridades.created_by > usuarios.id
Ref: paciente_prioridades.updated_by > usuarios.id

Ref: defunciones.paciente_id > pacientes.id
Ref: defunciones.medico_certifica_id > medicos.id
Ref: defunciones.created_by > usuarios.id
Ref: defunciones.updated_by > usuarios.id

Ref: paciente_enfermedades_cronicas.paciente_id > pacientes.id
Ref: paciente_enfermedades_cronicas.enfermedad_cronica_id > enfermedades_cronicas.id
Ref: paciente_enfermedades_cronicas.created_by > usuarios.id
Ref: paciente_enfermedades_cronicas.updated_by > usuarios.id

Ref: citas.paciente_id > pacientes.id
Ref: citas.medico_id > medicos.id
Ref: citas.estado_id > estados_cita.id
Ref: citas.created_by > usuarios.id
Ref: citas.updated_by > usuarios.id

Ref: consultas.cita_id > citas.id
Ref: consultas.paciente_id > pacientes.id
Ref: consultas.medico_id > medicos.id
Ref: consultas.created_by > usuarios.id
Ref: consultas.updated_by > usuarios.id

Ref: signos_vitales.consulta_id > consultas.id
Ref: signos_vitales.created_by > usuarios.id
Ref: signos_vitales.updated_by > usuarios.id

Ref: alergias.paciente_id > pacientes.id
Ref: alergias.created_by > usuarios.id
Ref: alergias.updated_by > usuarios.id

Ref: antecedentes.paciente_id > pacientes.id
Ref: antecedentes.created_by > usuarios.id
Ref: antecedentes.updated_by > usuarios.id

Ref: productos.tipo_producto_id > tipos_producto.id
Ref: productos.created_by > usuarios.id
Ref: productos.updated_by > usuarios.id

Ref: lotes.producto_id > productos.id
Ref: lotes.created_by > usuarios.id
Ref: lotes.updated_by > usuarios.id

Ref: movimientos_inventario.lote_id > lotes.id
Ref: movimientos_inventario.tipo_movimiento_id > tipos_movimiento_inventario.id
Ref: movimientos_inventario.created_by > usuarios.id
Ref: movimientos_inventario.updated_by > usuarios.id

Ref: recetas.paciente_id > pacientes.id
Ref: recetas.medico_id > medicos.id
Ref: recetas.estado_id > estados_receta.id
Ref: recetas.created_by > usuarios.id
Ref: recetas.updated_by > usuarios.id

Ref: receta_detalles.receta_id > recetas.id
Ref: receta_detalles.producto_id > productos.id
Ref: receta_detalles.created_by > usuarios.id
Ref: receta_detalles.updated_by > usuarios.id

Ref: alertas.paciente_id > pacientes.id
Ref: alertas.tipo_alerta_id > tipos_alerta.id
Ref: alertas.severidad_id > severidades_alerta.id
Ref: alertas.estado_id > estados_alerta.id
Ref: alertas.created_by > usuarios.id
Ref: alertas.updated_by > usuarios.id

Ref: auditoria_logs.usuario_id > usuarios.id

// =====================================================================
// AGRUPACIÓN VISUAL (dbdiagram.io)
// =====================================================================

TableGroup catalogos {
  roles
  estados_cita
  estados_paciente
  estados_receta
  tipos_producto
  tipos_movimiento_inventario
  tipos_alerta
  severidades_alerta
  estados_alerta
  categorias_prioridad
  especialidades
  enfermedades_cronicas
}

TableGroup auditoria {
  auditoria_logs
}

TableGroup usuarios_medicos {
  usuarios
  medicos
}

TableGroup pacientes_grupo {
  pacientes
  paciente_prioridades
  defunciones
  paciente_enfermedades_cronicas
}

TableGroup citas_historial {
  citas
  consultas
  signos_vitales
  alergias
  antecedentes
}

TableGroup farmacia {
  productos
  lotes
  movimientos_inventario
}

TableGroup recetas_grupo {
  recetas
  receta_detalles
}

TableGroup alertas_grupo {
  alertas
}
